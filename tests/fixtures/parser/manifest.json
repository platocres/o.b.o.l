      "command": "nxc smb 10.10.10.10 -u svc-audit -p WrongPassword",
      "stdout": "outputs/nxc_failed_login_refutes_validation.txt",
      "expected_supported_kinds": [
        "host.os_hint",
        "host.os_family",
        "smb.reachable"
      ],
      "expected_refuted_kinds": [
        "credential.validation"
      ],
      "expected_facts": [
        {
          "kind": "host.os_family",
          "value_contains": {"family": "windows"}
        },
        {
          "kind": "credential.validation",
          "state": "refuted",
          "value_contains": {"reason": "logon_failure"}
        }
      ],
      "forbidden_supported_kinds": [
        "credential.available",
        "smb.authenticated"
      ]
    },
